# Copy to .env.local for local development. Never commit real values.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Supabase: URL from Project Settings → Data API, keys from Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic (console.anthropic.com → API Keys) — server only
ANTHROPIC_API_KEY=
# RUNTIME SETTINGS: AI_ENABLED, DEMO_ENABLED, AI_*_USD, AERODATABOX_DAILY_UNITS, AERODATABOX_MIN_REMAINING,
# ORS_DAILY_REQUESTS, GEOAPIFY_DAILY_CREDITS and ALERT_ERRORS_24H can be changed on the admin page ("Einstellungen") without redeploying.
# Precedence: admin-page value > the variable below > code default, so these are now DEFAULTS.
# Exception: AI_ENABLED=false / DEMO_ENABLED=false here is a hard emergency off that the admin page cannot override.
# Phase 3 AI plan kill switch: only the exact value "true" (plus a key) enables generation/iteration. Unset = off.
AI_ENABLED=
# Daily AI budgets in USD per Europe/Berlin day (server only). Defaults shown; also set a monthly hard limit in the Anthropic console.
AI_USER_DAILY_USD=0.50
AI_ADMIN_DAILY_USD=2.00
# The shared demo account is one user, so this cap is shared by all demo visitors.
AI_DEMO_DAILY_USD=0.20
# Sum over all users; exceeded = budget_exceeded for everyone.
AI_GLOBAL_DAILY_USD=5.00
# Monthly AI spend alert threshold for the daily budget cron (warns at 80 %, errors at 100 %). Default 10.
AI_MONTHLY_ALERT_USD=10

# AeroDataBox via RapidAPI — server only
AERODATABOX_API_KEY=
# Quota guard (units per Europe/Berlin day across all users; refuse below this many remaining units per month). Defaults shown.
AERODATABOX_DAILY_UNITS=40
AERODATABOX_MIN_REMAINING=40

# OpenRouteService (driving times) — server only. Without a key plans generate without drive times.
OPENROUTESERVICE_API_KEY=
# Quota guard: matrix requests per Europe/Berlin day across all users (free Standard key allows ~500). Default shown.
ORS_DAILY_REQUESTS=400

# Public base URL used for login links in emails (server only, never taken from request headers).
# Optional on Vercel production (falls back to VERCEL_PROJECT_PRODUCTION_URL) and in dev (http://localhost:3000).
# Set it for a custom domain.
APP_URL=

# Shared demo account ("View demo" on the login page). Server only.
# Only the exact value "true" enables it; anything else (or unset) switches it off.
DEMO_ENABLED=false
DEMO_EMAIL=
# Long random string (e.g. `openssl rand -base64 32`). Never NEXT_PUBLIC_, never committed.
DEMO_PASSWORD=

# Sentry error tracking (docs/runbook.md "Sentry"). Everything is optional: without the DSN Sentry does nothing.
# DSN from Sentry -> Project Settings -> Client Keys (DSN). Not a secret, but public in the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time (Vercel build env only, NOT needed locally). SECRET. Org auth token, scope for source maps only.
SENTRY_AUTH_TOKEN=
# Slugs from the Sentry URL / Settings (needed together with the token)
SENTRY_ORG=
SENTRY_PROJECT=
# Only "true" enables GET /api/debug/sentry-test (throws on purpose). Leave unset normally.
SENTRY_TEST_ENABLED=

# Geoapify Places (primary source for places; OpenStreetMap data) — server only. Without a key places come from
# Overpass only (slow). Free plan: 3,000 credits/day. Quota guard (credits per Europe/Berlin day). Default shown.
GEOAPIFY_API_KEY=
GEOAPIFY_DAILY_CREDITS=2000

# Phase 2 external data (server only; no API keys needed: Open-Meteo, Overpass, Wikivoyage are keyless).
# Contact email put into the User-Agent of outgoing requests (Wikimedia and Overpass etiquette require it).
INTEGRATIONS_CONTACT=
# Optional Overpass endpoint override (default https://overpass-api.de/api/interpreter), e.g. a mirror if the shared IP is rate limited.
# The mirrors maps.mail.ru and overpass.private.coffee are always tried after it.
OVERPASS_URL=

# Phase 6 budget cron (docs/runbook.md section 10). Server only, never NEXT_PUBLIC_.
# Long random string. Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to /api/cron/budget-check; without it the route answers 401.
CRON_SECRET=
# Alert when more than this many app_events with level error occurred in the last 24 h. Default 20.
ALERT_ERRORS_24H=20
