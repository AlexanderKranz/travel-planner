# Copy to .env.local for local development. Never commit real values.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com → API Keys) — server only
ANTHROPIC_API_KEY=

# AeroDataBox via RapidAPI — server only
AERODATABOX_API_KEY=

# OpenRouteService (driving times) — server only
OPENROUTESERVICE_API_KEY=
