# Copy to .env.local for local development. Never commit real values.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Supabase: URL from Project Settings → Data API, keys from Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic (console.anthropic.com → API Keys) — server only
ANTHROPIC_API_KEY=

# AeroDataBox via RapidAPI — server only
AERODATABOX_API_KEY=

# OpenRouteService (driving times) — server only
OPENROUTESERVICE_API_KEY=

# Public base URL used for login links in emails (server only, never taken from request headers).
# Optional on Vercel production (falls back to VERCEL_PROJECT_PRODUCTION_URL) and in dev (http://localhost:3000).
# Set it for a custom domain.
APP_URL=

# Shared demo account ("View demo" on the login page). Server only.
# Only the exact value "true" enables it; anything else (or unset) switches it off.
DEMO_ENABLED=false
DEMO_EMAIL=
# Long random string (e.g. `openssl rand -base64 32`). Never NEXT_PUBLIC_, never committed.
DEMO_PASSWORD=

# Sentry error tracking (docs/runbook.md "Sentry"). Everything is optional: without the DSN Sentry does nothing.
# DSN from Sentry -> Project Settings -> Client Keys (DSN). Not a secret, but public in the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time (Vercel build env only, NOT needed locally). SECRET. Org auth token, scope for source maps only.
SENTRY_AUTH_TOKEN=
# Slugs from the Sentry URL / Settings (needed together with the token)
SENTRY_ORG=
SENTRY_PROJECT=
# Only "true" enables GET /api/debug/sentry-test (throws on purpose). Leave unset normally.
SENTRY_TEST_ENABLED=

# Phase 2 external data (server only; no API keys needed: Open-Meteo, Overpass, Wikivoyage are keyless).
# Contact email put into the User-Agent of outgoing requests (Wikimedia and Overpass etiquette require it).
INTEGRATIONS_CONTACT=
# Optional Overpass endpoint override (default https://overpass-api.de/api/interpreter), e.g. a mirror if the shared IP is rate limited.
OVERPASS_URL=
