{
  "name": "travel-planner",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/maplibre/copy-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/maplibre/copy-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals:live": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/live.eval.ts",
    "evals:group-text": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/group-text.eval.ts",
    "evals:patch-shrink": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/patch-shrink.eval.ts",
    "evals:port-places": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/port-places.eval.ts",
    "evals:tags-cases": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/tags-cases.eval.ts",
    "evals:itinerary": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/itinerary.eval.ts",
    "evals:itinerary-docs": "EVAL_DOCS=1 vitest run --config evals/vitest.config.ts evals/itinerary-docs.gen.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "airports:build": "node scripts/airports/build.mjs",
    "countries:build": "node scripts/countries/build.mjs",
    "demo:reset": "node scripts/demo/reset.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "suncalc": "^2.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
