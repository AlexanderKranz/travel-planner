{
  "name": "travel-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals:live": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/live.eval.ts",
    "evals:group-text": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/group-text.eval.ts",
    "evals:patch-shrink": "EVAL_LIVE=1 vitest run --config evals/vitest.config.ts evals/patch-shrink.eval.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "airports:build": "node scripts/airports/build.mjs",
    "countries:build": "node scripts/countries/build.mjs",
    "demo:reset": "node scripts/demo/reset.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "suncalc": "^2.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
